  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@solanaauth/core": "0.1.0",
    "@solanaauth/react": "0.1.0",
    "buffer": "6.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@solanaauth/platform": "0.1.0",
    "@solanaauth/testkit": "0.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.7"
  }
}
