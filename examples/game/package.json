{
  "name": "solanaauth-demo-game",
  "version": "0.1.0",
  "private": true,
  "description": "Demo: lojë në devnet me hyrje Google dhe sesion 24 orë vetëm për programin e lojës, pa konfirmime",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5176",
    "build": "tsc -p tsconfig.lib.json && tsc --noEmit -p tsconfig.json && vite build",
