# Kopjo në .env.local dhe plotëso.
VITE_RPC_URL=https://api.devnet.solana.com
# Nga `npm run setup-devnet` (ose nga results/devnet-solanaauth.md në main).
VITE_PROGRAM_ID=
# Google Cloud Console → Credentials → OAuth client ID (Web). Redirect URI: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
# Opsionale: Sign in with Apple (Services ID).
VITE_APPLE_CLIENT_ID=
# Prover-i dhe salt service (services/prover, services/salt).
VITE_PROVER_URL=http://localhost:8080/v1
VITE_SALT_URL=http://localhost:8787/salt
